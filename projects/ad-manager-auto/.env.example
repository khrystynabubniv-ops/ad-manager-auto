# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
PUBLIC_BASE_URL=http://localhost:3000
RUN_MIGRATIONS_ON_START=true

# Local development only. Keep false in production.
AUTH_DISABLED=true

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ad_manager_auto

# Notion
NOTION_TOKEN=
NOTION_ACTIVITIES_DATABASE_ID=b1ff9daa012c41c597e1d5ad5dd91917
NOTION_CAMPAIGNS_DATABASE_ID=058f62b067b6445c93a56e0b0600cf73
NOTION_WEBHOOK_SECRET=
WEBHOOK_SHARED_SECRET=

# Notion property names. Override only if you rename properties.
NOTION_PROP_AD_STATUS=Ad Status
NOTION_PROP_AD_TEXT=Ad Text
NOTION_PROP_CTA_LINK=CTA Link
NOTION_PROP_GOOGLE_DRIVE_LINK=Google Drive Link
NOTION_PROP_FINAL_PROJECT=Final project
NOTION_PROP_DESIGN_STATUS=Design Status
NOTION_PROP_PROJECT_TYPE=Project Type
NOTION_PROP_AUDIENCE=Audience
NOTION_PROP_LOCATION=Location
NOTION_PROP_FB_CAMPAIGN=Facebook Campaign
NOTION_PROP_FB_CAMPAIGN_ID=Facebook Campaign ID
NOTION_PROP_FB_ASSET_ID=Facebook Asset ID
NOTION_PROP_FB_ASSET_TYPE=Facebook Asset Type
NOTION_PROP_FB_AD_ID=Facebook Ad ID
NOTION_PROP_AD_ERROR=Ad Error
NOTION_PROP_AD_UPLOADED_AT=Ad Uploaded At
NOTION_PROP_AD_LAUNCHED_AT=Ad Launched At
NOTION_PROP_AD_LAST_SYNCED_AT=Ad Last Synced At
NOTION_PROP_AD_PREVIEW_URL=Ad Preview URL

# Google Drive
# Preferred on Railway: paste the full service account JSON as one variable.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative local option: path to service account file.
GOOGLE_APPLICATION_CREDENTIALS=

# Meta / Facebook Marketing API
FB_GRAPH_VERSION=v25.0
FB_APP_ID=
FB_APP_SECRET=
FB_ACCESS_TOKEN=
FB_AD_ACCOUNT_ID=
FB_PAGE_ID=
FB_DEFAULT_AD_STATUS=ACTIVE
FB_ENABLE_ADSET_CREATE=false
FB_DEFAULT_DAILY_BUDGET_MINOR=
FB_DEFAULT_TARGETING_JSON={"geo_locations":{"countries":["UA"]}}
MOCK_FACEBOOK=false

# Okta backend JWT verification
OKTA_ISSUER=
OKTA_CLIENT_ID=

# Vite / browser app
VITE_API_BASE_URL=
VITE_AUTH_DISABLED=true
VITE_OKTA_ISSUER=
VITE_OKTA_CLIENT_ID=
VITE_OKTA_REDIRECT_URI=http://localhost:5173/login/callback

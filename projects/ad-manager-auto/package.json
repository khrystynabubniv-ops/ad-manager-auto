{
  "name": "ad-manager-auto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./node_modules/.bin/tsx watch src/index.ts",
    "dev:ui": "./node_modules/.bin/vite --host 0.0.0.0",
    "build": "npm run build:server && npm run build:ui",
    "build:server": "./node_modules/.bin/esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "build:ui": "node scripts/build-ui.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "./node_modules/.bin/tsc --noEmit -p tsconfig.server.json && ./node_modules/.bin/tsc --noEmit -p tsconfig.ui.json",
    "db:migrate": "./node_modules/.bin/tsx scripts/migrate.ts",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "@okta/jwt-verifier": "^4.0.1",
    "@okta/okta-auth-js": "^8.0.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "form-data": "^4.0.1",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.27.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
